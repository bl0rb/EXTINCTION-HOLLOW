local animals = require "main.animals"
local collision = require "main.collision"
local movement = require "main.movement"

go.property("species", hash("lizard"))

local PLAYER = "/player"
local IDLE = hash("idle")
local WANDER = hash("wander")
local FLEE = hash("flee")

local function rest(self)
	self.state = IDLE
	self.timer = self.data.idle_time * (0.5 + math.random())
end

function init(self)
	self.data = animals.species[self.species]
	animals.alive[go.get_id()] = self.data
	local pos = go.get_position()
	self.x, self.y, self.z = pos.x, pos.y, pos.z
	self.angle = math.random() * 2 * math.pi
	go.set_rotation(vmath.quat_rotation_z(self.angle))
	rest(self)
end

function final(self)
	animals.alive[go.get_id()] = nil
end

function update(self, dt)
	local data = self.data
	local player = go.get_position(PLAYER)
	local dx, dy = self.x - player.x, self.y - player.y
	local dist = math.sqrt(dx * dx + dy * dy)
	if dist < data.fear_radius then
		self.state = FLEE
	elseif self.state == FLEE and dist > data.calm_radius then
		rest(self)
	end

	local speed = data.speed
	if self.state == FLEE then
		-- run straight away from the player
		local len = math.max(dist, 1)
		self.tx, self.ty = self.x + dx / len * 32, self.y + dy / len * 32
		speed = data.flee_speed
	elseif self.state == IDLE then
		self.timer = self.timer - dt
		if self.timer > 0 then
			return
		end
		local a = math.random() * 2 * math.pi
		local d = math.random() * data.wander_radius
		self.tx, self.ty = self.x + math.cos(a) * d, self.y + math.sin(a) * d
		self.state = WANDER
	end

	self.angle = movement.turn(self.angle, math.atan2(self.ty - self.y, self.tx - self.x), data.turn_speed * dt)
	local nx, ny, arrived = movement.step(self.x, self.y, self.tx, self.ty, speed * dt)
	local x = collision.is_blocked(nx, self.y, data.radius) and self.x or nx
	local y = collision.is_blocked(x, ny, data.radius) and self.y or ny
	if self.state == WANDER and (arrived or (x == self.x and y == self.y)) then
		rest(self)
	end
	self.x, self.y = x, y

	go.set_position(vmath.vector3(math.floor(x + 0.5), math.floor(y + 0.5), self.z))
	go.set_rotation(vmath.quat_rotation_z(self.angle))
end
