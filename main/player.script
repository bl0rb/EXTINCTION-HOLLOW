local animals = require "main.animals"
local collision = require "main.collision"
local movement = require "main.movement"
local pixel = require "main.pixel"

go.property("speed", 90) -- pixels per second
go.property("turn_speed", 12) -- radians per second
go.property("radius", 10) -- half size of the collision footprint in pixels
go.property("bite_range", 18) -- reach from the centre in pixels, added to the prey radius
go.property("carried_xp", 0) -- XP collected outside the cave, lost on death
go.property("banked_xp", 0) -- XP brought to the cave, kept permanently

local TOUCH = hash("touch")
local ENTER_CAVE = hash("enter_cave")
local CAVE = "/cave"
local SAVE_FILE = sys.get_save_file("extinction_hollow", "savegame")

local function eat(self)
	self.carried_xp = self.carried_xp + animals.alive[self.prey].xp
	animals.alive[self.prey] = nil
	go.delete(self.prey)
	self.prey = nil
	self.moving = false
end

function init(self)
	msg.post(".", "acquire_input_focus")
	local pos = go.get_position()
	self.x, self.y, self.z = pos.x, pos.y, pos.z
	self.angle = 0
	self.moving = false
	self.banked_xp = sys.load(SAVE_FILE).banked_xp or 0
end

function update(self, dt)
	local prey = self.prey and animals.alive[self.prey]
	if prey then
		-- keep chasing the selected prey wherever it runs
		local pos = go.get_position(self.prey)
		self.tx, self.ty = pos.x, pos.y
		self.moving = true
	elseif self.prey then
		self.prey = nil
		self.moving = false
	end
	if not self.moving then
		return
	end
	local target_angle = math.atan2(self.ty - self.y, self.tx - self.x)
	self.angle = movement.turn(self.angle, target_angle, self.turn_speed * dt)

	local nx, ny, arrived = movement.step(self.x, self.y, self.tx, self.ty, self.speed * dt)
	-- resolve each axis separately so the dino slides along walls
	local x = collision.is_blocked(nx, self.y, self.radius) and self.x or nx
	local y = collision.is_blocked(x, ny, self.radius) and self.y or ny
	if arrived or (x == self.x and y == self.y) then
		self.moving = false
	end
	self.x, self.y = x, y

	-- movement stays smooth internally, rendering snaps to whole pixels
	go.set_position(vmath.vector3(math.floor(x + 0.5), math.floor(y + 0.5), self.z))
	go.set_rotation(vmath.quat_rotation_z(self.angle))

	if prey and math.sqrt((self.tx - x) ^ 2 + (self.ty - y) ^ 2) <= self.bite_range + prey.radius then
		eat(self)
	end
end

function on_input(self, action_id, action)
	if action_id == TOUCH and action.pressed then
		local width, height = window.get_size()
		local cam = go.get_position("/camera")
		local zoom = go.get("/camera#camera", "zoom")
		-- a new click always replaces the previous target
		self.tx, self.ty = pixel.screen_to_world(action.screen_x, action.screen_y, cam.x, cam.y, zoom, width, height)
		-- clicking an animal selects it as prey, clicking the ground just walks there
		self.prey = animals.find_at(self.tx, self.ty)
		local cave = go.get_position(CAVE)
		if not self.prey and (self.tx - cave.x) ^ 2 + (self.ty - cave.y) ^ 2 <= go.get(CAVE .. "#cave", "radius") ^ 2 then
			-- clicking the cave walks right into its entrance
			self.tx, self.ty = cave.x, cave.y
		end
		self.moving = true
		return true
	end
end

function on_message(self, message_id, message)
	if message_id == ENTER_CAVE then
		-- XP is only safe once it is brought home
		self.banked_xp = self.banked_xp + self.carried_xp
		self.carried_xp = 0
		sys.save(SAVE_FILE, { banked_xp = self.banked_xp })
	end
end
