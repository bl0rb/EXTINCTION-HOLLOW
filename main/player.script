local movement = require "main.movement"
local pixel = require "main.pixel"

go.property("speed", 90) -- pixels per second
go.property("turn_speed", 12) -- radians per second
go.property("radius", 10) -- half size of the collision footprint in pixels

local TOUCH = hash("touch")
local TILEMAP = "/world#tilemap"
local LAYER = "ground"
local TILE_SIZE = 32
local BLOCKING_TILES = { [4] = true } -- rock

local function is_blocked(self, x, y)
	for _, ox in ipairs({ -self.radius, self.radius }) do
		for _, oy in ipairs({ -self.radius, self.radius }) do
			local cx = math.floor((x + ox) / TILE_SIZE) + 1
			local cy = math.floor((y + oy) / TILE_SIZE) + 1
			local b = self.bounds
			if cx < b.x or cy < b.y or cx >= b.x + b.w or cy >= b.y + b.h then
				return true
			end
			if BLOCKING_TILES[tilemap.get_tile(TILEMAP, LAYER, cx, cy)] then
				return true
			end
		end
	end
	return false
end

function init(self)
	msg.post(".", "acquire_input_focus")
	local pos = go.get_position()
	self.x, self.y, self.z = pos.x, pos.y, pos.z
	self.angle = 0
	self.moving = false
	local bx, by, bw, bh = tilemap.get_bounds(TILEMAP)
	self.bounds = { x = bx, y = by, w = bw, h = bh }
end

function update(self, dt)
	if not self.moving then
		return
	end
	local target_angle = math.atan2(self.ty - self.y, self.tx - self.x)
	self.angle = movement.turn(self.angle, target_angle, self.turn_speed * dt)

	local nx, ny, arrived = movement.step(self.x, self.y, self.tx, self.ty, self.speed * dt)
	-- resolve each axis separately so the dino slides along walls
	local x = is_blocked(self, nx, self.y) and self.x or nx
	local y = is_blocked(self, x, ny) and self.y or ny
	if arrived or (x == self.x and y == self.y) then
		self.moving = false
	end
	self.x, self.y = x, y

	-- movement stays smooth internally, rendering snaps to whole pixels
	go.set_position(vmath.vector3(math.floor(x + 0.5), math.floor(y + 0.5), self.z))
	go.set_rotation(vmath.quat_rotation_z(self.angle))
end

function on_input(self, action_id, action)
	if action_id == TOUCH and action.pressed then
		local width, height = window.get_size()
		local cam = go.get_position("/camera")
		local zoom = go.get("/camera#camera", "zoom")
		-- a new click always replaces the previous target
		self.tx, self.ty = pixel.screen_to_world(action.screen_x, action.screen_y, cam.x, cam.y, zoom, width, height)
		self.moving = true
		return true
	end
end
